// 图标映射函数
const getIcon = (iconType: string) => {
  switch (iconType) {
    case "graduation":
      return <GraduationCap />
    case "camera":
      return <Camera />
    case "palette":
      return <Palette />
    case "globe":
      return <Globe />
    case "users":
      return <Users />
    case "mail":
      return <Mail />
    default:
      return <Users />
  }
}

